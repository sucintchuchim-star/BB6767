local function createESPObj(player)
    if player == LocalPlayer then return end
    
    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Center = true
    nameText.Outline = true
    nameText.Size = 13

    local boxOutline = Drawing.new("Square")
    boxOutline.Visible = false
    boxOutline.Thickness = 1

    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = 1

    local distText = Drawing.new("Text")
    distText.Visible = false
    distText.Center = true
    distText.Outline = true
    distText.Size = 11

    local bloodHL = nil

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character.HumanoidRootPart
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                if _G.ESPName then
                    nameText.Text = player.Name
                    nameText.Position = Vector2.new(pos.X, pos.Y - 35)
                    nameText.Color = _G.ESPColor
                    nameText.Visible = true
                else
                    nameText.Visible = false
                end

                if _G.ESPDistance then
                    local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
                    distText.Text = "[" .. tostring(dist) .. "m]"
                    distText.Position = Vector2.new(pos.X, pos.Y + 15)
                    distText.Color = _G.ESPColor
                    distText.Visible = true
                else
                    distText.Visible = false
                end

                if _G.ESPBox then
                    local head = player.Character:FindFirstChild("Head")
                    if head then
                        local headPos = workspace.CurrentCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local height = math.abs(headPos.Y - pos.Y) * 2
                        boxOutline.Size = Vector2.new(height * 0.6, height)
                        boxOutline.Position = Vector2.new(pos.X - (height * 0.6) / 2, pos.Y - height / 2)
                        boxOutline.Color = _G.ESPColor
                        boxOutline.Visible = true
                    end
                else
                    boxOutline.Visible = false
                end

                if _G.ESPLine then
                    line.From = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y)
                    line.To = Vector2.new(pos.X, pos.Y)
                    line.Color = _G.ESPColor
                    line.Visible = true
                else
                    line.Visible = false
                end

                if _G.ESPBlood then
                    if not bloodHL or bloodHL.Parent ~= player.Character then
                        bloodHL = player.Character:FindFirstChild("BloodHighlight") or Instance.new("Highlight")
                        bloodHL.Name = "BloodHighlight"
                        bloodHL.Parent = player.Character
                        bloodHL.Adornee = player.Character
                        bloodHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        bloodHL.FillColor = _G.ESPColor
                    end
                    bloodHL.Enabled = true
                else
                    if player.Character:FindFirstChild("BloodHighlight") then
                        player.Character.BloodHighlight.Enabled = false
                    end
                end
            else
                nameText.Visible = false
                boxOutline.Visible = false
                line.Visible = false
                distText.Visible = false
            end
        else
            nameText.Visible = false
            boxOutline.Visible = false
            line.Visible = false
            distText.Visible = false
            if not Players:FindFirstChild(player.Name) then
                nameText:Remove()
                boxOutline:Remove()
                line:Remove()
                distText:Remove()
                connection:Disconnect()
            end
        end
    end)
end

